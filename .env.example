# 複製成 .env.local（本機）或設定到 Vercel 專案的 Environment Variables（正式環境）
# 隨機字串，例如：npx auth secret 或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID（Web application）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Neon Postgres（Vercel Storage 連接後會自動注入，本機不設就用 .data/dev-db.json）
# DATABASE_URL=
